{
	"name": "meituan-coze-bot",
	"version": "1.0.0",
	"description": "美团Coze机器人脚本集合",
	"scripts": {
		"dev": "tsc --watch",
		"build": "tsc && npm run clean",
		"clean": "find dist -name '*.js' -exec sed -i '' -e 's/^\"use strict\";//g' -e '/^Object\\.defineProperty.*__esModule.*$/d' -e '/^exports\\..*$/d' -e '/^module\\.exports.*$/d' {} \\; && rm -rf dist/types",
		"format": "prettier --write \"script/**/*.ts\" && eslint --fix \"script/**/*.ts\"",
		"format:check": "prettier --check \"script/**/*.ts\" && eslint \"script/**/*.ts\"",
		"lint": "eslint \"script/**/*.ts\"",
		"lint:fix": "eslint --fix \"script/**/*.ts\"",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage",
		"test:ci": "jest --ci --coverage --watchAll=false"
	},
	"devDependencies": {
		"@types/jest": "^29.5.0",
		"@types/node": "^24.3.3",
		"chokidar": "^4.0.3",
		"concurrently": "^9.2.1",
		"jest": "^29.5.0",
		"prettier": "^3.0.0",
		"ts-jest": "^29.1.0",
		"typescript": "^5.0.0"
	},
	"dependencies": {
		"dayjs": "^1.11.18"
	}
}
