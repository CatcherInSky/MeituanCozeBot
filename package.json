{
	"name": "meituan-coze-bot",
	"version": "1.0.0",
	"description": "美团Coze机器人脚本集合",
	"scripts": {
		"format": "prettier --write \"script/**/*.ts\" && eslint --fix \"script/**/*.ts\"",
		"format:check": "prettier --check \"script/**/*.ts\" && eslint \"script/**/*.ts\"",
		"lint": "eslint \"script/**/*.ts\"",
		"lint:fix": "eslint --fix \"script/**/*.ts\"",
